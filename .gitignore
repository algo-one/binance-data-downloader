# Compiled output. `mise run build` writes here; nothing in it belongs in git.
/bin/

# goreleaser's output. `mise run release:snapshot` fills this with binaries and
# archives for four platforms — a few hundred megabytes, all reproducible from
# a tag.
/dist/

# Test and coverage artefacts.
cover.out
coverage.html
*.test
*.out

# Go workspace files are per-developer, never shared.
go.work
go.work.sum

# mise's per-developer overrides. mise.toml is committed; these are not.
mise.local.toml
.mise.local.toml

# Downloaded market data. Cache directories can reach many gigabytes, and
# every byte is reproducible from Binance.
/data/
/.cache/

# macOS.
.DS_Store

# Claude Code local settings are gitignored globally (~/.gitignore_global),
# but this project commits them so the questions.md deny rule is shared.
!.claude/settings.local.json
